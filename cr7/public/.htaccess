# CR7.com.tr — Apache configuration (document root: cr7/public)

Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType font/ttf .ttf

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles (.env, .git …) but keep /.well-known for SSL (AutoSSL / Let's Encrypt).
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Canonical host: HTTPS + non-www (301).
    # Disable these two blocks only if the site is not served over HTTPS yet.
    # Behind Cloudflare/proxies the X-Forwarded-Proto check prevents redirect loops.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

    # Front controller: everything that is not an existing file goes to index.php.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json font/ttf image/x-icon image/vnd.microsoft.icon
</IfModule>

# Static files only. PHP sends its own Cache-Control for HTML, sitemaps, RSS and robots.txt (and
# an ETag for 304s); mod_expires would add an Expires header and merge a second, conflicting
# max-age into it, because PHP sends no Expires header of its own.
<IfModule mod_expires.c>
    <FilesMatch "\.(?:ico|webmanifest|png|jpe?g|webp|gif|svg|css|js|ttf|woff2?)$">
        ExpiresActive On
        ExpiresDefault "access plus 1 week"
        ExpiresByType image/x-icon "access plus 1 month"
        ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    # Versioned assets (/assets/...?v=mtime): cache for one year.
    <If "%{REQUEST_URI} =~ m#^/(public/)?assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    # Generated OG images: one week.
    <If "%{REQUEST_URI} =~ m#^/(public/)?og/#">
        Header set Cache-Control "public, max-age=604800"
    </If>
    <FilesMatch "\.(ttf|woff2?)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# CR7.com.tr — use this file ONLY if the domain's document root cannot point to cr7/public.
# It forwards every request into public/ and blocks access to application folders.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application code, configuration, data or tooling.
    RewriteRule ^(src|config|storage|database|bin|templates|content|tests|vendor)(/|$) - [F,L]
    RewriteRule ^(routes\.php|composer\.(json|lock)|README\.md)$ - [F,L]
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

    # Canonical host: HTTPS + non-www (301). Disable only while HTTPS is not available.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

    # /public/... must not be reachable as a duplicate URL.
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Everything else is handled inside public/ (its own .htaccess routes to index.php).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
